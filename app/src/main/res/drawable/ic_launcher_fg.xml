<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图标前景：按原版 PNG（432px）1:1 描摹的矢量，几何坐标由轮廓提取得到 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 立方体主体（六边形外轮廓，纯白） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M45.1,42.25 L29.25,50.5 L29.25,69.3 L45.1,78.25 L61,69.3 L61,50.5 Z" />

    <!-- 立方体三条可见棱线（浅灰，与原图同色号） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E3E4EA"
        android:strokeWidth="0.75"
        android:pathData="M29.25,50.5 L45,59.5" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E3E4EA"
        android:strokeWidth="0.75"
        android:pathData="M61,50.5 L45,59.5" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E3E4EA"
        android:strokeWidth="0.75"
        android:pathData="M45,59.5 L45.1,78.25" />

    <!-- 铅笔（白色笔身 + 圆角笔尾，轮廓取自原图） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M75.5,28 L76.75,28 L79.25,30.25 L79.25,31.75 L66.75,44.25 L61,46.25 L62.75,40.75 Z" />

    <!-- 笔尖分界线 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E3E4EA"
        android:strokeWidth="0.75"
        android:pathData="M62.45,40.9 L66.1,44.05" />
</vector>
